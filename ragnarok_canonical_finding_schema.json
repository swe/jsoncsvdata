{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragnarok.local/schemas/finding.schema.json",
  "title": "Ragnarok Finding",
  "description": "Canonical security finding normalized by ragnarok from arbitrary external or internal sources for visualization, correlation, and enrichment.",
  "type": "object",
  "required": [
    "id",
    "ragnarok",
    "source",
    "target",
    "classification",
    "evidence",
    "timestamps",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "ragnarok": {
      "type": "object",
      "required": [
        "title",
        "severity",
        "status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "in_progress",
            "resolved",
            "accepted",
            "false_positive",
            "ignored"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "impact": {
          "type": [
            "string",
            "null"
          ]
        },
        "recommendation": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "riskScore": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "isDuplicate": {
          "type": "boolean",
          "default": false
        },
        "duplicateOf": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "falsePositiveProbability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "findingId": {
          "type": [
            "string",
            "null"
          ]
        },
        "scanId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ]
        },
        "ipAddress": {
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "scheme": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "resource": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "classification": {
      "type": "object",
      "properties": {
        "owasp": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        },
        "cwe": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        },
        "wasc": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "cve": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CVE-[0-9]{4}-[0-9]+$"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "matcher": {
          "type": [
            "string",
            "null"
          ]
        },
        "matchedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameter": {
          "type": [
            "string",
            "null"
          ]
        },
        "extractedResults": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "http": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parameter": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "otherInfo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "request": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "method": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "httpVersion": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "body": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "raw": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              },
              "response": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "httpVersion": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "statusCode": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "statusText": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "body": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "raw": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "remediation": {
      "type": "object",
      "properties": {
        "solution": {
          "type": [
            "string",
            "null"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "timestamps": {
      "type": "object",
      "required": [
        "firstSeenAt",
        "lastSeenAt"
      ],
      "properties": {
        "firstSeenAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lastSeenAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "resolvedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "raw": {
      "type": [
        "object",
        "null"
      ],
      "description": "Original source payload before normalization.",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "required": [
        "schemaVersion",
        "normalizedBy"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "normalizedBy": {
          "const": "ragnarok"
        },
        "synthetic": {
          "type": "boolean",
          "default": false
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
